APP_PASSCODE=change-me

# Local development only — written by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# CONVEX_DEPLOY_KEY belongs in Vercel only (Production and Preview scopes), never
# here. Vercel builds run `npx convex deploy --cmd 'npm run build'`, which reads
# that key and injects NEXT_PUBLIC_CONVEX_URL itself. See docs/git-workflow.md.
